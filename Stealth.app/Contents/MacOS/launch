#!/bin/bash
# Stealth Launcher - Double-click to start
cd "$(dirname "$0")/../../.."

# Load .env
if [ -f ".env" ]; then
    export $(grep -v '^#' .env | xargs 2>/dev/null)
fi

# Activate venv
source venv/bin/activate 2>/dev/null

# Kill old processes
pkill -f "python.*backend.py" 2>/dev/null

# Start Python backend
python3 src/python/backend.py &
sleep 3

# Start Electron
./node_modules/.bin/electron .
