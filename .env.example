# Stealth — environment template
# Copy this to `.env` (untracked) only if you actually need env-based config
# during development. The Mac client itself does NOT read .env at runtime —
# user config lives in ~/.stealth/config.json.
#
# This file is here for the server during local-dev:
#   cd services/stealth-server
#   cp ../../.env.example .env
#   export $(grep -v '^#' .env | xargs)
#   uvicorn app:app --reload --port 8080

# Shared secret the Mac client must send in the Socket.IO `auth` payload.
# Anything goes — pick something long and random for production.
STEALTH_SHARED_SECRET=change-me-to-a-long-random-string

# Cloud Run injects this; locally we let uvicorn pick.
# PORT=8080
