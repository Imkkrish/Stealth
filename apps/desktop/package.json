{
  "name": "system-settings",
  "version": "1.0.0",
  "description": "System Preferences Helper",
  "main": "src/electron/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "concurrently \"npm run start-python\" \"npm run start-electron\"",
    "start-python": "python3 src/python/backend.py",
    "start-electron": "electron .",
    "build-python": "bash build_python.sh",
    "dist": "npm run build-python && electron-builder --mac",
    "dist:skip-python": "electron-builder --mac",
    "dist:dmg": "npm run build-python && electron-builder --mac dmg",
    "dist:zip": "npm run build-python && electron-builder --mac zip"
  },
  "author": "User",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^8.0.0",
    "electron": "^39.2.6",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "socket.io-client": "^4.7.0"
  },
  "build": {
    "appId": "com.apple.systemsettings.helper",
    "productName": "SystemSettings",
    "directories": {
      "output": "dist",
      "buildResources": "build-resources"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "bin/stealth-backend",
        "to": "bin/stealth-backend"
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build-resources/icon.icns",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "entitlements.mac.plist",
      "entitlementsInherit": "entitlements.mac.plist",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Required to hear the interviewer via BlackHole audio capture.",
        "NSSystemExtensionUsageDescription": "Required to capture system audio for transcription.",
        "NSCameraUsageDescription": "Required for vision analysis and screen reading features.",
        "NSAppleEventsUsageDescription": "Required for automation and accessibility features.",
        "NSScreenCaptureUsageDescription": "Required to analyze screen content for context-aware assistance.",
        "LSUIElement": true
      },
      "signIgnore": [
        "bin/stealth-backend"
      ]
    },
    "dmg": {
      "backgroundColor": "#1a1a2e",
      "title": "System Settings",
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  }
}